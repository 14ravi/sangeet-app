# ---------------------------------------------------------------------------
# FRONTEND (browser) variables — these are PUBLIC by design.
# Put them in Cloudflare Pages > Settings > Environment variables,
# or in .env.production.local for a local production build.
# ---------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "publishable" key (sb_publishable_...) or legacy "anon" key.
# Safe to expose: the database denies all direct access (RLS, no policies).
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets — set with `npx supabase secrets set ...`.
# NEVER put these in Cloudflare, in a VITE_ variable, or in Git.
# ---------------------------------------------------------------------------
# ADMIN_BOOTSTRAP_USERNAME=choose-a-username
# ADMIN_BOOTSTRAP_PASSWORD=choose-a-long-password-at-least-10-chars
# Optional: lock the API to your site origin(s), comma separated
# ALLOWED_ORIGINS=https://your-project.pages.dev

# ---------------------------------------------------------------------------
# LOCAL MODE (npm run local:api) reads the two ADMIN_BOOTSTRAP_* values from
# a git-ignored .env.local file in the project root.
# ---------------------------------------------------------------------------
